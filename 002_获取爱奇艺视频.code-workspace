{
    "folders": [
        {
            "name": "002_获取爱奇艺视频",
            "path": "D:/VSCode/personal_tools/002_获取爱奇艺视频"
        },
        {
            "name": "personal_tools",
            "path": "."
        },
        {
            "path": "C:/Users/Administrator/.codex"
        },
        {
            "path": "E:/qycache"
        },
        {
            "path": "Z:/003_电视剧"
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "C:/ProgramData/miniconda3/envs/test_regression_py3.12/python.exe",
        "python.terminal.activateEnvironment": true,
        "python.testing.cwd": "${workspaceFolder:002_获取爱奇艺视频}",
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": [
            // 输出每个测试用例的执行结果。
            "-v",
            // 从工具目录下的 tests 文件夹发现测试。
            "-s", "tests",
            // 以工具目录为导入根目录，供测试导入业务模块和共用测试资源路径。
            "-t", "."
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "爱奇艺：链接下载",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:002_获取爱奇艺视频}/download_iqiyi.py",
                "cwd": "${workspaceFolder:002_获取爱奇艺视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 必填：引用链接清单、主配置和当前客户端播放 SDK 适配；客户端打开任意正片暂停一次即可。
                    "--config", "${workspaceFolder:002_获取爱奇艺视频}/configs/playback.yaml"
                    // 可选：只处理某个清单下标，从 0 开始，可重复指定；仍遵循 all-parts。
                    // , "--index", "0"
                    // 可选：过滤展开后的正整数集序，可重复指定，不能扩展 all-parts=false 的任务。
                    // , "--episode", "1"
                    // 可选：仅解析公开正片目录，不请求播放会话或下载媒体。
                    // , "--plan"
                ]
            },// python download_iqiyi.py --config configs/playback.yaml
            {
                "name": "爱奇艺：研究链接播放会话",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:002_获取爱奇艺视频}/research/probe_playback.py",
                "cwd": "${workspaceFolder:002_获取爱奇艺视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 必填：读取播放会话、网络、采样、并发及客户端适配的专项 YAML。
                    "--config", "${workspaceFolder:002_获取爱奇艺视频}/configs/playback.yaml",
                    // 必填：当前 download_list 列表下标，从 0 开始，按实际配置调整。
                    "--index", "0"
                    // 可选且互斥：按任务 quality 验证短段；或完整获取链接指定集并验证后发布到主配置 output_path。
                    // , "--sample-media"
                    // , "--full-media"
                ]
            },
            {
                "name": "爱奇艺：批量转换 QSV",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:002_获取爱奇艺视频}/decode_qsv.py",
                "cwd": "${workspaceFolder:002_获取爱奇艺视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 必填：指定主 YAML 配置；输入、输出及 decode_verification.cpu/gpu 均读取该文件。
                    "--config", "${workspaceFolder:002_获取爱奇艺视频}/configs/config.yaml"
                ]
            },
            {
                "name": "爱奇艺：比较 CPU/GPU 解码",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:002_获取爱奇艺视频}/tests/benchmark_decode.py",
                "cwd": "${workspaceFolder:002_获取爱奇艺视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 必填：读取主配置中的成品目录、本地工作目录、FFmpeg 和运行超时。
                    "--config", "${workspaceFolder:002_获取爱奇艺视频}/configs/config.yaml",
                    // 必填：设置比较任务数量、并发数、CPU/GPU 后端、预热和报告位置。
                    "--benchmark-config", "${workspaceFolder:002_获取爱奇艺视频}/research/configs/benchmark_decode.yaml"
                    // 可选：只比较某一组；省略时按专项配置运行全部组，可重复传入 --case。
                    // , "--case", "mixed_parallel"
                ]
            },
            {
                "name": "爱奇艺：验收 CPU/GPU 验证",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:002_获取爱奇艺视频}/tests/accept_verification.py",
                "cwd": "${workspaceFolder:002_获取爱奇艺视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 必填：主配置，复用已登记成品、源文件下载保护和 FFmpeg。
                    "--config", "${workspaceFolder:002_获取爱奇艺视频}/configs/config.yaml",
                    // 必填：专项配置，只读取报告根目录；两种设备分别验收正常及截断副本。
                    "--benchmark-config", "${workspaceFolder:002_获取爱奇艺视频}/research/configs/benchmark_decode.yaml"
                ]
            }
        ]
    }
}
