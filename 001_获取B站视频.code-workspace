{
    "folders": [
        {
            "name": "001_获取B站视频",
            "path": "D:/VSCode/personal_tools/001_获取B站视频"
        },
        {
            "name": "personal_tools",
            "path": "."
        },
        {
            "path": "C:/Users/Administrator/.codex"
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "C:/ProgramData/miniconda3/envs/test_regression_py3.12/python.exe",
        "python.terminal.activateEnvironment": false,
        "python.testing.cwd": "${workspaceFolder:001_获取B站视频}",
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": [
            // 输出每个测试用例的执行结果。
            "-v",
            // 从工具目录下的 tests 文件夹发现测试。
            "-s", "tests",
            // 以工具目录为导入根目录，供测试导入业务模块和共用测试资源路径。
            "-t", "."
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "B站：打开 Cookie 导出工具",
                "detail": "在默认 Chrome 打开 chrome://extensions，开启开发者模式，加载打开的 chrome_cookie_export 文件夹，然后点击扩展导出 B 站登录态。",
                "type": "process",
                "command": "explorer.exe",
                "args": ["${workspaceFolder:001_获取B站视频}/chrome_cookie_export"],
                "problemMatcher": []
            },
            {
                "label": "B站：准备环境",
                "type": "process",
                "command": "${config:python.defaultInterpreterPath}",
                "args": [
                    "-m", "pip", "install", "--isolated", "--proxy", "",
                    "--index-url", "https://mirrors.aliyun.com/pypi/simple",
                    "-r", "${workspaceFolder:001_获取B站视频}/requirements.txt"
                ],
                "options": {
                    "cwd": "${workspaceFolder:001_获取B站视频}",
                    "env": {
                        "HTTP_PROXY": "",
                        "HTTPS_PROXY": "",
                        "ALL_PROXY": "",
                        "PIP_PROXY": "",
                        "NO_PROXY": "*",
                        "PYTHONUTF8": "1"
                    }
                },
                "problemMatcher": [],
                "presentation": { "reveal": "always", "panel": "dedicated" }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "B站：验证 Chrome 登录态",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 仅验证配置的登录态，不下载视频。
                    "--login-only"
                ]
            },
            {
                "name": "B站：查看画质与字幕",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 输入视频链接、BV/AV 号或 YAML 清单路径；相对路径以此工具目录为基准，可重复传入 --url。
                    "--url", "${input:bilibiliUrl}",
                    // 仅查看当前账号可下载画质、参考编码和字幕；不进入清晰度确认、不下载。
                    "--list-formats"
                ]
            },
            {
                "name": "B站：下载当前分 P",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 输入视频链接或 YAML 清单；普通链接按 p 选分P并选择一次上限，清单按档位并集排名确定上限。
                    "--url", "${input:bilibiliUrl}"
                ]
            },
            {
                "name": "B站：下载全部分 P",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 输入视频链接或 YAML 清单路径；例如 download_list/download_list.yaml。
                    "--url", "${input:bilibiliUrl}",
                    // 普通链接下载全部分P并选择一次画质上限；清单的 all-parts 优先覆盖此默认值。
                    "--all-parts",
                    // 下载后拼接：-1 不拼接，0 拼接全部，其他值分组拼接；清单项、清单全局的 merge-parts 优先。
                    // 下载后拼接使用各P实际分配的画质，不另弹菜单；每组必须同档，混合目录也不跨画质拼接。
                    // 分 P 编号从 1 开始，1 对应 P1；0 只能单独输入，不能作为组内编号。
                    // 示例 1-3,5;4,2,4：第一组依次拼接 P1、P2、P3、P5，第二组依次拼接 P4、P2、P4。
                    // 使用英文逗号和分号；范围包含首尾，保留顺序和重复项，每组至少两个片段。
                    "--merge-parts", "${input:bilibiliDownloadMergeParts}"
                ]
                // python download_bilibili.py --url download_list/download_list.yaml
            },
            {
                "name": "B站：拼接已下载分 P",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 输入已下载视频的 BV 号或普通 BV 链接；无需登录，多清晰度时在终端选择一个，不跨目录补齐。
                    "--merge-video", "${input:bilibiliMergeId}",
                    // 离线拼接：-1 不拼接，0 或留空拼接全部；其他值按表达式分组拼接。
                    // 分 P 编号从 1 开始，1 对应 P1；0 只能单独输入，不能作为组内编号。
                    // 示例 1-3,5;4,2,4：第一组依次拼接 P1、P2、P3、P5，第二组依次拼接 P4、P2、P4。
                    // 使用英文逗号和分号；范围包含首尾，保留顺序和重复项，每组至少两个片段。
                    "--merge-parts", "${input:bilibiliMergeParts}"
                ]
            },
            {
                "name": "B站：补生成视频信息",
                "type": "debugpy",
                "request": "launch",
                "python": "${config:python.defaultInterpreterPath}",
                "program": "${workspaceFolder:001_获取B站视频}/download_bilibili.py",
                "cwd": "${workspaceFolder:001_获取B站视频}",
                "console": "integratedTerminal",
                "env": { "PYTHONUTF8": "1" },
                "args": [
                    // 可选：指定 YAML 配置文件；默认读取脚本同目录下的 config.yaml。
                    "--config", "${workspaceFolder:001_获取B站视频}/config.yaml",
                    // 扫描配置的下载目录，迁移旧记录并补充视频信息；无需输入链接，不下载或拼接视频。
                    "--refresh-metadata"
                ]
            }
        ],
        "inputs": [
            {
                "id": "bilibiliUrl",
                "type": "promptString",
                "description": "输入视频链接、BV/AV 号或 YAML 清单路径（如 download_list/download_list.yaml，相对工具目录）"
            },
            {
                "id": "bilibiliMergeId",
                "type": "promptString",
                "description": "输入已下载视频的 BV 号或普通 BV 视频链接"
            },
            {
                "id": "bilibiliDownloadMergeParts",
                "type": "promptString",
                "description": "下载后拼接：-1 不拼接，0 拼接全部，或输入范围如 1-5,8,10-12;10-12",
                "default": "-1"
            },
            {
                "id": "bilibiliMergeParts",
                "type": "promptString",
                "description": "离线拼接：-1 不拼接，0 或留空拼接全部，或输入范围如 1-5,8,10-12;10-12",
                "default": "0"
            }
        ]
    }
}
